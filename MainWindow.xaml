<Window x:Class="DICOMizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DICOMizer"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Patient ID -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Patient ID:"
                   Margin="5" VerticalAlignment="Center" FontSize="14"/>
        <TextBox Grid.Row="0" Grid.Column="1" Name="patientIdTextBox"
                 Margin="5" Padding="5" FontSize="14" Text="DICOMizer"/>

        <!-- Accession Number -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Accession #:"
                   Margin="5" VerticalAlignment="Center" FontSize="14"/>
        <TextBox Grid.Row="1" Grid.Column="1" Name="accessionNumberTextBox"
                 Margin="5" Padding="5" FontSize="14"/>

        <!-- Choose File Button -->
        <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                Content="Choose File" Margin="5" Padding="10"
                Click="ChooseFile_Click"/>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Convert" Margin="5" Padding="10,5"
                    MinWidth="100" Click="Convert_Click"/>
            <Button Content="Cancel" Margin="5" Padding="10,5"
                    MinWidth="100" Click="Cancel_Click"/>
            <Button Content="Open Output" Margin="5" Padding="10,5"
                    MinWidth="100" Click="OpenOutput_Click"/>
            <Button Content="Dump DICOM" Margin="5" Padding="10,5"
                    MinWidth="100" Click="Dump_Click"/>
        </StackPanel>

        <!-- Progress Bar -->
        <ProgressBar Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                     Height="25" Margin="5" Name="progressBar"
                     Minimum="0" Maximum="100"/>

        <!-- Status Label -->
        <TextBlock Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                   Name="statusText" Margin="5" FontSize="14"
                   TextWrapping="Wrap" Text="Ready."/>
    </Grid>

</Window>
